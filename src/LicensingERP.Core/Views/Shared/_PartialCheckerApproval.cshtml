@model List<MakerCheckerData<object>>

<span class="dropdown-header">@Model.Count Approvals Remain</span>
<div class="dropdown-divider"></div>
@{ 
    List<MakerCheckerData<object>> modeldata = Model.Take(5).ToList();
}
@foreach (MakerCheckerData<object> dataOnHold in modeldata)
{
    <a href="@Url.Action("Index", "Checker", new { area = string.Empty })" class="dropdown-item">
        @{
            #region Settings
            string icon = "";
            string color = "";
            string text = "";
            //int val = 0;
            //string txt = "";
            //TimeSpan timeSpan = GenericLogic.IstNow - dataOnHold.TransactionDate;
            //if (timeSpan.TotalMinutes < 60)
            //{
            //    val = (int)timeSpan.TotalMinutes;
            //    txt = "mins";
            //}
            //else if (timeSpan.TotalMinutes > 60 && timeSpan.TotalHours < 24)
            //{
            //    val = (int)timeSpan.TotalHours;
            //    txt = "hrs";
            //}
            //else if (timeSpan.TotalHours > 24)
            //{
            //    val = (int)timeSpan.TotalDays;
            //    txt = "days";
            //}
            if (dataOnHold.ePurpose == eMakerCheckerPurpose.Insert)
            {
                color = "#3d9970";
                text = "Added";
            }
            else if (dataOnHold.ePurpose == eMakerCheckerPurpose.Update)
            {
                color = "#ffc107";
                text = "Updated";
            }
            else if (dataOnHold.ePurpose == eMakerCheckerPurpose.Deactivate)
            {
                color = "#dc3545";
                text = "Deactivated";
            }
            switch (dataOnHold.eCaseType)
            {
                case eMakerCheckerCaseType.UserGroup:
                    {
                        icon = "fa-user-plus";
                    }
                    break;
                case eMakerCheckerCaseType.User:
                    {
                        icon = "fa-user";
                    }
                    break;
                case eMakerCheckerCaseType.ClientCategory:
                    {
                        icon = "fa-user-tag";
                    }
                    break;
                case eMakerCheckerCaseType.Client:
                    {
                        icon = "fa-user-tie";
                    }
                    break;
                case eMakerCheckerCaseType.LicenseType:
                    {
                        icon = "fa-id-card";
                    }
                    break;
                case eMakerCheckerCaseType.Product:
                    {
                        icon = "fa-box";
                    }
                    break;
                case eMakerCheckerCaseType.Parameter:
                    {
                        icon = "fa-hands-helping";
                    }
                    break;
                case eMakerCheckerCaseType.WFProcess:
                    {
                        icon = "fa-hourglass";
                    }
                    break;
                case eMakerCheckerCaseType.ProductFeatures:
                    {
                        icon = "fa-th-list";
                    }
                    break;
            }
            #endregion
                    }

        <i class="fas @icon mr-2" style="color:@color"></i> @dataOnHold.eCaseType.ToString() @text
        <span class="float-right text-muted text-sm">
            @((GenericLogic.IstNow - dataOnHold.TransactionDate).ShortDuration()) ago
        </span>
    </a>
    <div class="dropdown-divider"></div>
}
<a href="@Url.Action("Index", "Checker", new { area = string.Empty })" class="dropdown-item dropdown-footer">Show All</a>